{
  "name": "xc-strategy-round-table",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "format": "prettier --write app components lib tests *.ts *.mjs *.json",
    "test:ai": "AI_MODE=mock OPENAI_API_KEY= XC_OFFLINE_TEST=1 NODE_OPTIONS='--conditions=react-server --require ./tests/helpers/phase1-no-api.cjs' playwright test -c playwright.ai.config.ts",
    "eval:agents": "XC_LIVE_EVAL=1 NODE_OPTIONS=--conditions=react-server playwright test -c playwright.evaluation.config.ts"
  },
  "dependencies": {
    "docx": "^9.9.0",
    "fflate": "^0.8.3",
    "lucide-react": "1.50.0",
    "next": "16.3.8",
    "openai": "^7.30.0",
    "pdfmake": "^0.3.11",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
